# bkn301-inference gateway — configuration reference.
#
# ENVIRONMENT VARIABLES ARE THE ONLY CONFIG SURFACE (PRD §4.4d, R10).
# Staging is planned for Azure, production cloud is undecided, and OCI is the
# testing environment. The image therefore contains no cloud SDK, no instance
# principal, no managed identity, no Key Vault client. The platform injects;
# we read. That is the one mechanism every candidate platform supports.

# ── Server ───────────────────────────────────────────────────────────────────
# 0.0.0.0 is correct here, unlike in the AI service: this process is an
# authenticating edge and is meant to receive forwarded traffic.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ── Upstream vLLM ────────────────────────────────────────────────────────────
# Comma-separated. Private network only -- vLLM replicas have no public IP and
# run with --disable-log-requests.
UPSTREAM_URLS=http://127.0.0.1:8001/v1
# vLLM's single static --api-key. This is the whole reason the gateway exists:
# that key is all the auth vLLM has (PRD §5.1). It never leaves the private net.
UPSTREAM_API_KEY=
UPSTREAM_CONNECT_TIMEOUT_SEC=5.0
UPSTREAM_READ_TIMEOUT_SEC=120.0

# ── Authentication ───────────────────────────────────────────────────────────
API_KEY_STORE_PATH=./keys.json
# Applied on top of argon2id's per-key salt, and deliberately NOT stored beside
# the key file: a stolen store is then insufficient for an offline attack.
API_KEY_PEPPER=

# PEM public key. ASYMMETRIC ONLY -- the gateway must be able to verify tokens
# and unable to mint them, so that compromising it cannot forge caller identity.
# A symmetric algorithm is refused at construction.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ISSUER=firstdata-api
JWT_AUDIENCE=bkn301-inference

# ── Request validation ───────────────────────────────────────────────────────
# Without the allowlist a caller names any model string and reaches whatever
# else that vLLM process serves.
ALLOWED_MODELS=Qwen/Qwen3-8B-AWQ
MAX_BODY_BYTES=1048576
# One 8k-context request costs what twenty short ones do (PRD §5.3).
MAX_COMPLETION_TOKENS=2048
MAX_PROMPT_TOKENS=7000

# ── Audit ────────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./logs/audit.jsonl
# Exists to be greppable, not to be enabled. On, the audit log becomes a PII
# store. tests/test_audit_no_prompt_text.py asserts it stays off.
AUDIT_INCLUDE_PROMPT_TEXT=false

METRICS_ENABLED=true
